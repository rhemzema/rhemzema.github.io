---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const DRIVE_ID = '16BJaZmmX7ZM_sW_otVHfL_wDuC9--Ux6';
const viewUrl = `https://drive.google.com/file/d/${DRIVE_ID}/view?usp=drive_link`;
const previewUrl = `https://drive.google.com/file/d/${DRIVE_ID}/preview`;
const downloadUrl = `https://drive.google.com/uc?export=download&id=${DRIVE_ID}`;
---
<Base title="Resume | Ruiqian Zhang">
  <Nav home />

  <div class="content-wrap">
    <div class="container">
      <div class="resume-header">
        <h1 class="split-flip-text">Resume</h1>
        <div class="header-actions reveal-flip" data-delay="200">
          <a href={viewUrl} class="pill download-link" target="_blank" rel="noopener">
            Open in Drive
            <svg class="resume-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
          <a href={downloadUrl} class="pill" download>Download</a>
        </div>
      </div>

      <div class="pdf-shell reveal-flip" data-delay="300">
        <div class="pdf-toolbar">
          <div class="pdf-toolbar-left">
            <span class="pdf-filename">Ruiqian_Zhang_Resume.pdf</span>
            <span class="pdf-badge">PDF</span>
          </div>
        </div>

        <div class="pdf-frame-wrap">
          <div class="pdf-loader" id="pdf-loader">
            <div class="pdf-loader-spinner"></div>
            <span class="pdf-loader-text">Loading resume…</span>
          </div>

          <iframe id="pdf-frame" src={previewUrl} title="Ruiqian Zhang Resume" allow="autoplay" loading="lazy"></iframe>

          <div class="pdf-fallback" id="pdf-fallback">
            <div class="pdf-fallback-icon"></div>
            <p>The PDF can't be previewed here.<br>
              <a href={viewUrl} target="_blank" rel="noopener">Open in Google Drive</a> to view it.
            </p>
          </div>
        </div>
      </div>

      <p class="resume-note reveal-flip" data-delay="400">
        Having trouble viewing?
        <a href={viewUrl} target="_blank" rel="noopener">Open directly in Google Drive</a>
        or
        <a href={downloadUrl}>download the PDF</a>.
      </p>
    </div>
  </div>

  <Footer />

  <Fragment slot="scripts">
    <script is:inline>
      RZ.splitFlipText();
      RZ.initScrollProgress();
      RZ.observeReveal();

      const frame = document.getElementById('pdf-frame');
      const loader = document.getElementById('pdf-loader');
      const fallback = document.getElementById('pdf-fallback');
      let loaded = false;

      frame.addEventListener('load', () => {
        loaded = true;
        setTimeout(() => {
          frame.classList.add('loaded');
          loader.classList.add('hidden');
        }, 800);
      });

      setTimeout(() => {
        if (!loaded) {
          loader.classList.add('hidden');
          fallback.classList.add('show');
        }
      }, 12000);
    </script>
  </Fragment>
</Base>

<style>
  .content-wrap {
    min-height: 100vh; display: flex; flex-direction: column; align-items: center;
    padding: 100px 20px 40px; box-sizing: border-box;
  }
  .container { width: 100%; max-width: 920px; }

  .resume-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; gap: 16px; flex-wrap: wrap;
  }
  .resume-header h1 { font-size: 32px; font-weight: 800; margin: 0; letter-spacing: -0.5px; line-height: 1.2; }
  .header-actions { display: flex; gap: 10px; align-items: center; }

  .pdf-shell {
    width: 100%; border-radius: 20px; overflow: hidden;
    border: 1px solid var(--border);
    background: var(--section-bg);
    box-shadow: 0 4px 24px var(--shadow-color);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }
  .pdf-shell:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 8px 40px var(--shadow-color);
  }

  .pdf-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 16px; gap: 12px;
    border-bottom: 1px solid var(--border);
    background: var(--card-bg);
  }
  .pdf-toolbar-left { display: flex; align-items: center; gap: 8px; }

  .pdf-filename {
    font-size: 13px; font-weight: 600; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px;
  }
  .pdf-badge {
    font-size: 10px; font-weight: 700; letter-spacing: 0.05em;
    padding: 3px 8px; border-radius: 999px; text-transform: uppercase;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .pdf-frame-wrap { position: relative; width: 100%; height: 85vh; min-height: 500px; background: var(--section-bg); }
  .pdf-frame-wrap iframe {
    position: absolute; inset: 0; width: 100%; height: 100%;
    border: none; display: block; opacity: 0; transition: opacity 0.5s ease;
  }
  .pdf-frame-wrap iframe.loaded { opacity: 1; }

  .pdf-loader {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 14px;
    pointer-events: none; transition: opacity 0.4s ease;
  }
  .pdf-loader.hidden { opacity: 0; }
  .pdf-loader-spinner {
    width: 28px; height: 28px; border: 2px solid var(--border);
    border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .pdf-loader-text { font-size: 13px; color: var(--muted); }

  .pdf-fallback {
    display: none; position: absolute; inset: 0;
    flex-direction: column; align-items: center; justify-content: center;
    gap: 16px; padding: 40px; text-align: center;
  }
  .pdf-fallback.show { display: flex; }
  .pdf-fallback-icon {
    width: 48px; height: 48px; opacity: 0.3; background: var(--text);
    -webkit-mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z' stroke='black' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpolyline points='14 2 14 8 20 8' stroke='black' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") no-repeat center / contain;
    mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z' stroke='black' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpolyline points='14 2 14 8 20 8' stroke='black' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") no-repeat center / contain;
  }
  .pdf-fallback p { color: var(--muted); font-size: 14px; margin: 0; line-height: 1.6; }
  .pdf-fallback a { color: var(--accent); text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .pdf-fallback a:hover { border-bottom-color: var(--accent); }

  .resume-note { margin-top: 14px; text-align: center; font-size: 13px; color: var(--muted); }
  .resume-note a { color: var(--accent); text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .resume-note a:hover { border-bottom-color: var(--accent); }

  .home-icon { width: 20px; height: 20px; display: block; background-color: currentColor; -webkit-mask: url('/icons/home.svg') no-repeat center / contain; mask: url('/icons/home.svg') no-repeat center / contain; }
  .resume-arrow { width: 16px; height: 16px; margin-left: 6px; transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1); }
  @media (hover: hover) { .download-link:hover .resume-arrow { transform: translate(3px, -3px); } }

  @media (max-width: 600px) {
    .resume-header { flex-direction: column; align-items: flex-start; }
    .pdf-filename  { max-width: 160px; }
    .pdf-frame-wrap { height: 75vh; }
  }

  .resume-header :global(.char-flip) {
    transform: translateY(20px); opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .resume-header :global(.char-flip.visible) { transform: translateY(0); opacity: 1; }
</style>
