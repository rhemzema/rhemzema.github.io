---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---
<Base title="About Ruiqian Zhang">
  <div id="card-backdrop"></div>
  <button id="card-close-btn" aria-label="Close card">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div class="top-nav-safe"></div>
  <div class="top-nav-bg"></div>
  <nav class="nav-wrapper">
    <div class="nav-right-group">
      <ThemeToggle />
    </div>
  </nav>

  <div class="content-wrap">
    <main>
      <!-- Section 1: Hero -->
      <section id="home" class="page">
        <div class="inner">
          <div style="text-align:center;max-width:900px;width:100%">
            <h1 class="split-flip-text">Ruiqian Zhang</h1>
            <p class="reveal-flip" data-delay="300">📍 Blacksburg, VA</p>
            <div class="social-pills">
              <a class="icon-btn square pop-in" style="animation-delay:400ms" href="https://github.com/rhemzema" target="_blank"><img src="/icons/github_64x.svg" alt="GitHub"></a>
              <a class="icon-btn square linkedin pop-in" style="animation-delay:450ms" href="https://linkedin.com/in/ruiqianzhang" target="_blank"><img src="/icons/linkedin_64x.svg" alt="LinkedIn"></a>
              <a class="icon-btn square pop-in" style="animation-delay:500ms" href="https://instagram.com/rhemzema" target="_blank"><img src="/icons/instagram_64x.svg" alt="Instagram"></a>
              <a class="icon-btn square x pop-in" style="animation-delay:550ms" href="https://x.com/rhemzema" target="_blank"><img src="/icons/x_300x.svg" alt="X"></a>
            </div>
            <div class="pill-row" style="margin-top:16px;">
              <a class="pill pill-wipe" href="/projects/" style="animation-delay:500ms">All Projects</a>
              <a class="pill pill-wipe" href="mailto:rhema@vt.edu" style="animation-delay:500ms">Email</a>
            </div>
            <div class="pill-row">
              <a class="pill pill-accent pill-wipe" href="#about" id="about-btn" style="animation-delay:750ms">
                <span class="slot-scroller">
                  <span class="slot-label">About Me</span>
                  <span class="slot-label">About Me</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: About + ID card -->
      <section id="about" class="about-layout">
        <div class="reveal-flip id-card-container" data-delay="200">
          <div class="id-card-wrapper" id="id-wrapper">
            <div class="student-id" id="id-card">
              <img src="/images/Ruiqian_Card.png" alt="Ruiqian Zhang">
              <div class="id-glare"  id="id-glare"></div>
              <div class="holo-foil" id="holo-foil"></div>
            </div>
          </div>
        </div>
        <div class="intro-text">
          <h2 class="reveal-flip">About Me</h2>
          <p class="reveal-flip">I'm Ruiqian Zhang. (Or Rhema)</p>
          <p class="reveal-flip">I'm an electrical engineering student at Virginia Tech. My interest in hardware started with competitive robotics and has since grown to cover PCB design, embedded systems, and building electronic projects.</p>
          <p class="reveal-flip">I care about making things that are well-engineered, feels good to use, and not just functional. When I'm not in the lab, you'll find me gaming, watching F1, or picking up whatever new hobby caught my attention that week!</p>
          <a href="/resume/" class="pill download-link reveal-flip" target="_blank" style="margin-top:12px;display:inline-flex;align-items:center;">
            View Resume
            <svg class="resume-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- Section 3: Projects + Footer -->
      <div class="projects-footer-group">
        <section id="home-projects-section">
          <h2 class="reveal-flip">Recent Projects</h2>
          <div class="arc-deck-outer" id="arc-deck-outer">
            <div class="arc-deck-stage" id="arc-deck-stage"></div>
          </div>
          <div class="arc-indicators" id="arc-indicators" aria-hidden="true">
            <svg id="arc-dots-svg" viewBox="0 0 200 40" preserveAspectRatio="xMidYMid meet"></svg>
          </div>
        </section>

        <div class="site-footer-container">
          <button class="icon-btn square scroll-to-top" id="scroll-to-top" aria-label="Scroll to top">
            <span class="slot-scroller">
              <span class="slot-label"><div class="icon-mask arrow-icon"></div></span>
              <span class="slot-label"><div class="icon-mask arrow-icon"></div></span>
            </span>
          </button>
          <footer class="site-footer">&copy; {new Date().getFullYear()} Ruiqian Zhang</footer>
        </div>
      </div>
    </main>
  </div>

  <Fragment slot="scripts">
    <script src="/scripts/home.js" is:inline></script>
    <script is:inline>
      RZ.splitFlipText();
      RZ.observeReveal();
      document.getElementById('scroll-to-top').addEventListener('click', () =>
        window.scrollTo({ top: 0, behavior: 'smooth' }),
      );
      RZ.initScrollProgress();
      document.getElementById('about-btn').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('about').scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    </script>
  </Fragment>
</Base>

<style is:global>
  html { scroll-behavior: smooth; }
  body { min-height: 100vh; }
  body.card-expanded { touch-action: none !important; }

  body.card-expanded .nav-right-group { pointer-events: none; }

  .content-wrap { padding: 0 20px; }

  .page .inner {
    min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: 28px; box-sizing: border-box;
  }
  #home  { margin-bottom: 5vh; }

  .about-layout {
    max-width: 900px; width: 100%; margin: 0 auto 140px;
    position: relative; z-index: 20;
    display: flex; flex-direction: row;
    align-items: center; justify-content: space-between; gap: 60px;
  }
  body.card-expanded .about-layout { z-index: 950; }

  .intro-text { flex: 1; transition: opacity 0.4s ease; }
  body.card-expanded .intro-text { opacity: 0; pointer-events: none; }

  #home-projects-section { max-width: 900px; width: 100%; margin: 0 auto; }
  #home-projects-section h2 { text-align: center; }
  #home-projects-section p  { text-align: center; color: var(--muted); margin-top: 12px; }

  .projects-footer-group {
    min-height: 100svh;
    display: flex; flex-direction: column; justify-content: flex-end;
  }

  .social-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .pill-row {
    margin-top: 12px;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
  }

  .id-card-container { width: 100%; display: flex; justify-content: center; position: relative; }
  @media (min-width: 901px) { .id-card-container { width: auto; display: block; } }

  .id-card-wrapper {
    --tx: 0px; --ty: 0px; --s: 1;
    transform: translate3d(var(--tx), var(--ty), 0) scale(var(--s));
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    perspective: 2500px; width: 100%; max-width: 300px;
    flex-shrink: 0;
    z-index: 10; touch-action: none; cursor: pointer;
  }
  .id-card-wrapper.expanded { z-index: 1000; }

  .student-id {
    --rx: 0deg; --ry: 0deg; --px: 50%; --py: 50%;
    position: relative; width: 100%; aspect-ratio: 149 / 208;
    background: transparent; border-radius: 20px;
    border: none; padding: 0; box-sizing: border-box;
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease;
  }
  .student-id.interacting { transition: transform 0.15s ease-out, box-shadow 0.15s ease-out; }
  .student-id img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; display: block; border-radius: 20px; }

  .id-glare {
    position: absolute; inset: 0; border-radius: 20px; z-index: 20; pointer-events: none;
    background: radial-gradient(farthest-corner circle at var(--px) var(--py), rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.15) 50%, transparent 90%);
    mix-blend-mode: overlay; opacity: 0; transition: opacity 0.4s ease;
  }
  .holo-foil {
    position: absolute; inset: 0; border-radius: 20px; z-index: 21; pointer-events: none;
    background-image: linear-gradient(115deg, transparent 15%, rgba(255,115,0,0.6) 25%, rgba(255,215,0,0.6) 35%, rgba(0,255,150,0.6) 45%, rgba(0,150,255,0.6) 55%, rgba(150,0,255,0.6) 65%, transparent 75%);
    background-size: 300% 300%;
    background-position: calc(100% - var(--px)) calc(100% - var(--py));
    mix-blend-mode: color-dodge; opacity: 0; transition: opacity 0.4s ease;
    filter: brightness(0.8) contrast(1.5);
  }
  body.dark .holo-foil { filter: brightness(0.7) contrast(1.8); }
  .student-id.interacting .id-glare  { opacity: 0.4; }
  .student-id.interacting .holo-foil { opacity: 0.25; }

  @keyframes spin-y {
    0%   { transform: rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)); }
    100% { transform: rotateX(var(--rx,0deg)) rotateY(calc(var(--ry,0deg) + 360deg)); }
  }
  .spin-360 { animation: spin-y 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275); }

  .arc-deck-outer {
    position: relative; width: 100%; height: 440px;
    margin-top: 24px; margin-bottom: 10px; overflow: hidden;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    mask-composite: intersect;
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .arc-deck-outer.deck-visible { opacity: 1; transform: translateY(0); }
  .arc-deck-stage { position: absolute; inset: 0; pointer-events: none; }

  .arc-card {
    position: absolute; width: 260px; height: 340px;
    border-radius: 18px; box-sizing: border-box;
    text-decoration: none; color: var(--text);
    pointer-events: auto; cursor: pointer; overflow: hidden;
    display: flex; flex-direction: column;
    transform-origin: bottom center;
    transition: box-shadow 0.35s ease, border-color 0.25s ease, opacity 0.5s ease, transform 0.35s ease, translate 0.35s ease;
    opacity: 0;
  }
  .arc-card.card-in { opacity: 1; }
  body:not(.dark) .arc-card { background: #fff; border: 1px solid rgba(16,24,40,0.09); box-shadow: 0 4px 20px rgba(11,95,255,0.07), 0 1px 3px rgba(0,0,0,0.05); }
  body.dark       .arc-card { background: #0f1e30; border: 1px solid rgba(255,255,255,0.09); box-shadow: 0 6px 28px rgba(0,0,0,0.45); }

  @media (hover: hover) {
    .arc-card:hover { border-color: var(--accent) !important; box-shadow: 0 16px 44px var(--shadow-color), 0 3px 10px rgba(11,95,255,0.12) !important; z-index: 200 !important; translate: 0 -20px; }
    .arc-card:hover .arc-card-thumb img { transform: scale(1.05); }
    .arc-card-viewall:hover { border-style: solid !important; }
    .arc-card-viewall:hover .viewall-icon { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  }
  .arc-card:active { opacity: 0.85 !important; }

  .arc-card-thumb {
    width: 100%; height: 155px; flex-shrink: 0; overflow: hidden; position: relative;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, var(--bg)), color-mix(in srgb, var(--accent) 6%, var(--bg)));
  }
  .arc-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.25,1,0.5,1); }
  .arc-card-thumb::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 55%, transparent 100%);
    pointer-events: none;
  }
  .arc-card-thumb-placeholder {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 22%, var(--bg)) 0%, color-mix(in srgb, var(--accent) 8%, var(--bg)) 100%);
  }
  .arc-card-thumb-placeholder svg { width: 28px; height: 28px; color: var(--accent); opacity: 0.3; }
  .arc-card-title {
    position: absolute; bottom: 10px; left: 14px; right: 14px; z-index: 1;
    font-size: 16px; font-weight: 700; margin: 0; color: #fff;
    line-height: 1.3; text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    transition: color 0.25s ease;
  }
  .arc-card-thumb.no-image .arc-card-title { color: var(--text); text-shadow: none; }
  .arc-card-thumb.no-image::after { display: none; }

  .arc-card-body  { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .arc-card-desc  { font-size: 14px; color: var(--muted); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5; flex: 1; }
  .arc-card-meta  { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding-top: 6px; border-top: 1px solid var(--border); }
  .arc-status-pill {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 12px; font-weight: 600; color: var(--muted);
    background: var(--section-bg); border: 1px solid var(--border);
    border-radius: 999px; padding: 3px 8px; letter-spacing: 0.01em;
  }
  .arc-status-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }
  .arc-status-dot[data-status="in-progress"] { background: #3b82f6; box-shadow: 0 0 4px #3b82f6; }
  .arc-status-dot[data-status="on-hold"]     { background: #eab308; box-shadow: 0 0 4px #eab308; }
  .arc-status-dot[data-status="dropped"]     { background: #ef4444; box-shadow: 0 0 4px #ef4444; }
  .arc-status-dot[data-status="completed"]   { background: #22c55e; box-shadow: 0 0 4px #22c55e; }
  .arc-card-date  { font-size: 12px; color: var(--muted); font-weight: 500; white-space: nowrap; }

  .arc-card-viewall { align-items: center; justify-content: center; gap: 10px; }
  body:not(.dark) .arc-card-viewall, body.dark .arc-card-viewall { border-style: dashed; }
  .viewall-icon  { width: 44px; height: 44px; border-radius: 50%; background: var(--hover-bg); display: flex; align-items: center; justify-content: center; transition: background 0.3s ease; }
  .viewall-label { font-size: 15px; font-weight: 700; text-align: center; line-height: 1.35; }
  .viewall-count { font-size: 13px; color: var(--muted); font-weight: 500; }

  .arc-indicators { display: flex; justify-content: center; margin-top: 0; margin-bottom: 40px; pointer-events: none; }
  #arc-dots-svg { width: 220px; height: 44px; overflow: visible; }
  .arc-dot { transition: r 0.35s ease, fill 0.35s ease, opacity 0.35s ease; }

  @media (max-width: 900px) {
    .about-layout { flex-direction: column-reverse; align-items: center; gap: 40px; text-align: center; margin-bottom: 100px; }
    .id-card-wrapper { margin: 0 auto; max-width: 250px; }
    .download-link { margin: 12px auto 0 auto !important; }
  }
  @media (max-width: 600px) {
    .arc-deck-outer { height: 380px; }
    .arc-card { width: 210px; height: 290px; }
    .arc-card-thumb { height: 130px; }
    .arc-card-desc { font-size: 13px; -webkit-line-clamp: 2; }
    .arc-card-title { font-size: 15px; }
    .arc-card-body { padding: 10px 12px 12px; }
  }

  .scroll-to-top { position: relative; margin: 0 auto 20px; z-index: 10; opacity: 1 !important; pointer-events: auto !important; }
</style>
